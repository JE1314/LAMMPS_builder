# LAMMPS input script to minimize energy of configuration in in.UNK_4CA822

units           real
atom_style      full
boundary        p p p


# Define force field (example: OPLS-AA, update as needed)
pair_style      lj/cut/coul/long 10.0 10.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  cvff
pair_modify     mix geometric
special_bonds   lj/coul 0.0 0.0 0.5 

# Read data file
read_data       UNK_4CA822.lmp


kspace_style    pppm 1.0e-4

# Neighbor list
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

dump            dump1 all atom 10 lopls.dump
# Output
thermo          100
thermo_style    custom step pe etotal press temp

# # Short run at 300 K before minimization
# velocity        all create 500.0 12345 mom yes rot yes dist gaussian
# fix             nvt_run all nvt temp 500.0 500.0 100.0
# timestep        1.0
# run             100000
# unfix           nvt_run

# Energy minimization settings
min_style       cg
#min_modify      line quadratic
minimize       0 0  100000 100000


write_data      minimized.data
